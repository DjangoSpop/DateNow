# Copy to .env (git-ignored) or export in your shell.
# Backend ORIGIN (no /api/v1). Leave unset in dev to use http://localhost:8000
# (iOS simulator / web) or http://10.0.2.2:8000 (Android emulator).
# Physical device on the same Wi-Fi: use your computer LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=

# development | preview | production (production REQUIRES an https EXPO_PUBLIC_API_URL)
APP_ENV=development
