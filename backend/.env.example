# Database Configuration
DATABASE_URL=postgresql://datenow:datenow123@localhost:5432/datenow

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Configuration
# Optional: the API starts without it; AI features fail only when used.
GEMINI_API_KEY=

# Security
# Required outside ENVIRONMENT=development/testing: >= 32 chars, not a placeholder (startup is refused otherwise).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
ENVIRONMENT=development
DEBUG=False
API_V1_STR=/api/v1
PROJECT_NAME=DateNow

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AI Settings
AI_MODEL=gemini-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
