# Copy to backend/.env and fill in real values. Never commit .env.
# Placeholders only - none of these values are usable secrets.

# Application
# development | testing | production
ENVIRONMENT=development
DEBUG=false
# log every SQL statement (dev only)
SQL_ECHO=false
API_V1_STR=/api/v1
PROJECT_NAME=DateNow

# Database (schema is managed by Alembic: run `alembic upgrade head` from backend/)
DATABASE_URL=postgresql://datenow:CHANGE_ME@localhost:5432/datenow

# Redis
REDIS_URL=redis://localhost:6379

# Security (REQUIRED). In production the app refuses to start with a
# placeholder or a secret shorter than 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
# only HS256 is accepted
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth rate limit: attempts per minute per client IP (and per email for login).
# In-process only (per worker). 0 disables.
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS: JSON array or comma-separated list. "*" is rejected (credentials are allowed).
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AI (optional). Leave empty to run without AI features.
GEMINI_API_KEY=
AI_MODEL=gemini-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
